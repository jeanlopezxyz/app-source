# syntax=docker/dockerfile:1
# Build: docker build -f frontend/Containerfile --build-arg VERSION=1.0.0 -t catalogo-frontend:1.0.0 frontend

# Writes the version into config.js. Runs on the host architecture (no QEMU).
FROM --platform=$BUILDPLATFORM docker.io/library/alpine:3.24 AS build
ARG VERSION=dev
COPY public/ /out/
RUN printf 'window.CATALOGO_FRONTEND_VERSION = "%s";\n' "$VERSION" > /out/config.js

# Final image: nginx without root privileges, listening on 8080.
FROM docker.io/nginxinc/nginx-unprivileged:1.31.7-alpine3.24
LABEL org.opencontainers.image.source="https://github.com/jeanlopezxyz/app-source"
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /out/ /usr/share/nginx/html/
USER 101
EXPOSE 8080
