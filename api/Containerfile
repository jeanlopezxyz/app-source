# syntax=docker/dockerfile:1
# Build: docker build -f api/Containerfile --build-arg VERSION=1.0.0 -t catalogo-api:1.0.0 api

# The build stage runs on the host architecture and cross-compiles (no QEMU).
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.4-alpine3.24 AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath \
      -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o /out/catalogo-api .

# Final image: no shell, no package manager, non-root user (65532).
FROM gcr.io/distroless/static-debian13:nonroot
LABEL org.opencontainers.image.source="https://github.com/jeanlopezxyz/app-source"
COPY --from=build /out/catalogo-api /catalogo-api
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/catalogo-api"]
CMD ["serve"]
